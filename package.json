{
  "name": "llm-tier-router",
  "version": "0.1.0",
  "description": "Route each LLM request to the cheapest model tier that can handle it. A free local model scores complexity; code picks the model; every call is costed.",
  "type": "module",
  "license": "MIT",
  "author": "Idris-Michael Bakare",
  "repository": "github:Idris-Michael/llm-tier-router",
  "engines": { "node": ">=22.13" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "prices.json"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "bench": "tsx bench/run.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
